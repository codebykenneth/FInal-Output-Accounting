{
  "hosting": {
    "site": "accountingsolver-644ee",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/", "destination": "/index.xml", "type": 302 }
    ],
    "headers": [
      { "source": "**/*.xml", "headers": [
        { "key": "Content-Type", "value": "application/xhtml+xml; charset=utf-8" }
      ] },
      { "source": "**/*.@(xml|js|webmanifest)", "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
